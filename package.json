{
  "name": "@sebastian-software/analytics-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.22.x" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/integration/*.test.ts",
    "test:container": "node scripts/test-container.ts",
    "db:migrate": "node --env-file-if-exists=.env.migration src/migrate.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
