# Local development fixtures only. Never reuse these credentials outside Compose.
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://analytics_app:local-runtime-only@127.0.0.1:55432/analytics
DATABASE_TLS=disable
RELEASE_ID=local

# Optional standard OIDC login: set all four together; keep real secrets outside Git.
# AUTH_ISSUER_URL=http://localhost:8180/auth/v1/
# AUTH_PUBLIC_URL=http://127.0.0.1:3001
# AUTH_CLIENT_ID=analytics-browser
# AUTH_CLIENT_SECRET=<confidential-browser-client-secret>

# Optional native WorkOS mode (mutually exclusive with legacy OIDC settings).
# AUTH_PUBLIC_URL=http://127.0.0.1:3002
# WORKOS_CLIENT_ID=<AuthKit-application-client-id>
# WORKOS_AUTHKIT_URL=https://<environment>.authkit.app
# WORKOS_API_KEY=<server-only-staging-or-production-key>
# WORKOS_COOKIE_PASSWORD=<independent-64-hex-character-session-sealing-key>
