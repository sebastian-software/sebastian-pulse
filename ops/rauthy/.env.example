# Synthetic local-only settings. Copy to .env; never use these values outside localhost.
POSTGRES_DB=rauthy
POSTGRES_USER=rauthy
POSTGRES_PASSWORD=rauthy-local-postgres-only-change-me
PG_HOST=postgres
PG_PORT=5432
PG_DB_NAME=rauthy
