  "query": "\n            SELECT workspace_id, id, project_id, name, event_name, version, created_at, updated_at\n            FROM analytics.goals\n            WHERE workspace_id = $1\n              AND ($2::uuid IS NULL OR id > $2)\n            ORDER BY id\n            LIMIT $3\n            ",
